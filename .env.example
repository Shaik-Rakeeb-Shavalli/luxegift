# ─────────────────────────────────────────────────────────────────────────────
# LuxeGift — Environment Variables Template
#
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Prisma / PostgreSQL — optional, system falls back gracefully) ──
DATABASE_URL="postgresql://postgres:password@localhost:5432/luxegift"
DIRECT_URL="postgresql://postgres:password@localhost:5432/luxegift"

# ── Supabase (optional — not in active use, can leave blank) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Cloudinary (optional — image uploads) ────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ── Resend (optional — email notifications) ──────────────────────────────────
RESEND_API_KEY=""

# ── Razorpay (required for live payment processing) ──────────────────────────
# Server-side keys (never expose to client)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Public key used by client-side Razorpay checkout widget
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Firebase (required — primary database & authentication) ──────────────────
# These NEXT_PUBLIC_ vars are exposed to the browser (standard Firebase practice)
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# ── Seed API (optional — protects the /api/seed-firestore endpoint) ───────────
# Generate a random strong token and include it in the Authorization header:
# curl -H "Authorization: Bearer <your-token>" http://localhost:3000/api/seed-firestore
SEED_SECRET=""

# ── Site URL (used for SEO metadata base) ────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://your-deployed-url.vercel.app"
